op-button" onclick="window.scrollTo({top:0, behavior:\'smooth\'}); return false;">\xe2\x86\x91</a>\n\n  <footer class="sp-footer">\n    <span><strong>S&amp;P</strong> \xc2\xb7 Smart Nutritionist Program</span>\n    <span>\xec\x8b\x9d\xec\x9e\x90\xec\x9e\xac \xc2\xb7 \xec\x8b\x9d\xeb\x8b\xa8 \xc2\xb7 \xec\x8b\x9d\xec\x88\x98 \xec\x98\x88\xec\xb8\xa1 \xc2\xb7 \xeb\xb0\x9c\xec\xa3\xbc \xc2\xb7 \xeb\xac\xb8\xec\x84\x9c\xed\x99\x94</span>\n  </footer>\n\n  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>\n  \n<!-- \xeb\x93\xb1\xeb\xa1\x9d\xeb\x90\x9c \xec\x9c\xa0\xed\x9a\xa8 \xeb\xa9\x94\xeb\x89\xb4 \xeb\xaa\xa9\xeb\xa1\x9d\xec\x9d\x84 \xec\x9e\x90\xeb\xb0\x94\xec\x8a\xa4\xed\x81\xac\xeb\xa6\xbd\xed\x8a\xb8 \xeb\xb0\xb0\xec\x97\xb4\xeb\xa1\x9c \xec\xa0\x84\xeb\x8b\xac -->\n<script>\n  const validMenus = [\n    \n      "\xec\x8c\x80\xeb\xb0\xa5"\n    \n  ];\n\n  const DELETE_DIET_MENU_URL_TPL = "/meals/api/diet-menu/ID/delete/";\n\n  function getDeleteUrl(dietMenuId) {\n    return DELETE_DIET_MENU_URL_TPL.replace("ID", dietMenuId);\n  }\n\n  function getCsrfToken() {\n    const el = document.querySelector(\'[name=csrfmiddlewaretoken]\');\n    if (el) return el.value;\n    // \xec\xbf\xa0\xed\x82\xa4\xec\x97\x90\xec\x84\x9c CSRF \xed\x86\xa0\xed\x81\xb0 \xea\xb0\x80\xec\xa0\xb8\xec\x98\xa4\xea\xb8\xb0 (\xed\x95\x84\xec\x9a\x94\xec\x8b\x9c)\n    const match = document.cookie.match(/csrftoken=([^;]+)/);\n    return match ? match[1] : \'\';\n  }\n\n  function renderWeeklyMenus(dateStr, mealType, menus) {\n    const box = document.getElementById(`week-${dateStr}-${mealType}`);\n    if (!box) return;\n\n    if (!menus || menus.length === 0) {\n      box.innerHTML = `<span style="background:#f1f3f5;color:#868e96;">\xeb\xaf\xb8\xeb\x93\xb1\xeb\xa1\x9d</span>`;\n      return;\n    }\n\n    box.innerHTML = menus.map(menu => {\n      const dietMenuId = menu.diet_menu_id || menu.id || "";\n      return `<span data-diet-menu-id="${dietMenuId}">${menu.name}<button type="button" class="sp-week-menu-del delete-btn delete-menu" title="\xec\x82\xad\xec\xa0\x9c" data-diet-menu-id="${dietMenuId}" data-date="${dateStr}" data-meal="${mealType}">&times;</button></span>`;\n    }).join("");\n  }\n\n  async function deleteWeeklyMenu(dietMenuId, dateStr, mealType, chipEl) {\n    if (!dietMenuId) return;\n\n    try {\n      const resp = await fetch(getDeleteUrl(dietMenuId), {\n        method: "POST",\n        headers: { "X-CSRFToken": getCsrfToken(), "Content-Type": "application/json" },\n      });\n      const data = await resp.json();\n\n      if (data.status !== "success") {\n        alert(data.message || "\xec\x82\xad\xec\xa0\x9c\xec\x97\x90 \xec\x8b\xa4\xed\x8c\xa8\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.");\n        return;\n      }\n\n      renderWeeklyMenus(dateStr, mealType, data.menus || []);\n    } catch (e) {\n      alert("\xeb\x84\xa4\xed\x8a\xb8\xec\x9b\x8c\xed\x81\xac \xec\x98\xa4\xeb\xa5\x98\xea\xb0\x80 \xeb\xb0\x9c\xec\x83\x9d\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.");\n    }\n  }\n\n  async function addWeeklyMenu(button) {\n    const row = button.closest(".sp-week-add");\n    const input = row.querySelector("input");\n    const menuName = input.value.trim();\n    const dateStr = input.dataset.date;\n    const mealType = input.dataset.meal;\n\n    if (!menuName) return;\n\n    // [\xed\x95\xb5\xec\x8b\xac \xea\xb2\x80\xec\xa6\x9d] \xeb\x93\xb1\xeb\xa1\x9d\xeb\x90\x9c \xeb\xa9\x94\xeb\x89\xb4 \xeb\xaa\xa9\xeb\xa1\x9d\xec\x97\x90 \xec\xa1\xb4\xec\x9e\xac\xed\x95\x98\xeb\x8a\x94\xec\xa7\x80 \xed\x99\x95\xec\x9d\xb8\n    if (!validMenus.includes(menuName)) {\n      alert(`"${menuName}"\xec\x9d\x80(\xeb\x8a\x94) \xeb\x93\xb1\xeb\xa1\x9d\xeb\x90\x98\xec\xa7\x80 \xec\x95\x8a\xec\x9d\x80 \xeb\xa9\x94\xeb\x89\xb4\xec\x9e\x85\xeb\x8b\x88\xeb\x8b\xa4.\\n\xec\x83\x81\xeb\x8b\xa8\xec\x9d\x98 \'\xeb\xa9\x94\xeb\x89\xb4 \xec\xb6\x94\xea\xb0\x80 \xeb\x93\xb1\xeb\xa1\x9d\'\xec\x9d\x84 \xed\x86\xb5\xed\x95\xb4 \xeb\xa8\xbc\xec\xa0\x80 \xeb\x93\xb1\xeb\xa1\x9d \xed\x9b\x84 \xec\x82\xac\xec\x9a\xa9\xed\x95\xb4\xec\xa3\xbc\xec\x84\xb8\xec\x9a\x94.`);\n      input.focus();\n      return;\n    }\n\n    try {\n      const response = await fetch("/meals/api/menus/add/", {\n        method: "POST",\n        headers: {"Content-Type": "application/json", "X-CSRFToken": getCsrfToken()},\n        body: JSON.stringify({\n          date: dateStr,\n          meal_type: mealType,\n          menu_name: menuName\n        })\n      });\n\n      const data = await response.json();\n\n      if (data.status !== "success") {\n        alert(data.message || "\xeb\xa9\x94\xeb\x89\xb4 \xec\xa0\x80\xec\x9e\xa5\xec\x97\x90 \xec\x8b\xa4\xed\x8c\xa8\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.");\n        return;\n      }\n\n      input.value = "";\n      renderWeeklyMenus(dateStr, mealType, data.menus || []);\n    } catch (e) {\n      alert("\xeb\x84\xa4\xed\x8a\xb8\xec\x9b\x8c\xed\x81\xac \xec\x98\xa4\xeb\xa5\x98\xea\xb0\x80 \xeb\xb0\x9c\xec\x83\x9d\xed\x96\x88\xec\x8a\xb5\xeb\x8b\x88\xeb\x8b\xa4.");\n    }\n  }\n\n  document.addEventListener("DOMContentLoaded", function () {\n    document.querySelectorAll(".sp-week-add input").forEach((input) => {\n      input.addEventListener("keydown", function (event) {\n        if (event.key === "Enter") {\n          event.preventDefault();\n          addWeeklyMenu(input.closest(".sp-week-add").querySelector("button"));\n        }\n      });\n    });\n\n    // Event Delegation for delete buttons\n    document.addEventListener("click", function (event) {\n      const delBtn = event.target.closest(".sp-week-menu-del, .delete-btn, .delete-menu");\n      if (!delBtn) return;\n\n      event.preventDefault();\n      const dietMenuId = delBtn.dataset.dietMenuId || delBtn.getAttribute("data-diet-menu-id");\n      const dateStr = delBtn.dataset.date || delBtn.getAttribute("data-date");\n      const mealType = delBtn.dataset.meal || delBtn.getAttribute("data-meal");\n      const chip = delBtn.closest("span");\n\n      if (dietMenuId) {\n        deleteWeeklyMenu(dietMenuId, dateStr, mealType, chip);\n      }\n    });\n  });\n</script>\n\n</body>\n</html>\n'

